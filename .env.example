# Local: copie este arquivo para apps/web/.env.local.
# Vercel: cadastre as variáveis no painel em Preview e Production.
# APP_ORIGIN pode ficar vazia para usar o endereço gerado pela Vercel.
APP_ORIGIN=
REVIEWLAB_PORT=3000
WHATSAPP_GROUP_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GEMINI_API_KEY=
TRIAGE_MODEL=gemini-3.1-flash-lite
TRIAGE_MONTHLY_CALL_LIMIT=100
TRIAGE_TRANSCRIBE_AUDIO=0
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=reviewlab-private
# Segredo aleatório com pelo menos 16 caracteres.
CRON_SECRET=
# Na Vercel, habilita a versão do pnpm fixada no package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
